# ===================================================
# UNIWERSALNY SZABLON ZMIENNYCH ŚRODOWISKOWYCH (.env.example)
# Skopiuj ten plik jako '.env' i uzupełnij własne, tajne klucze API.
# ===================================================

# 1. KLUCZE API (API Keys)
# Pobierz klucz z Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Pobierz klucz z xAI Console: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# 2. DEFINICJE RÓL MULTI-AGENT (Kilo Code / Agent Workflow)
# Domyślny model konwersacyjny i główny punkt kontaktowy
DEFAULT_MODEL=grok-4.6

# Rola Architekta / Orkiestratora (Duży kontekst, analiza modeli B2B/LTO, VPP/Smart Grid)
ARCHITECT_MODEL=gemini-3.1-pro

# Rola Wykonawcy / Kodera (Najwyższa precyzja algorytmiczna, generowanie i refaktoryzacja kodu)
IMPLEMENTER_MODEL=grok-4.6

# Rola Pomocnicza / Podpowiedzi (Niskie opóźnienie, autouzupełnianie, mikrozadania w tle)
FAST_LITE_MODEL=gemini-3-flash

# 3. ALIASY DLA ROUTINGU VS CODE (Settings.json)
# Proste zapytania tekstowe i pomocnicze skrypty
GEMINI_MODEL_LITE=gemini-3-flash-lite

# Domyślny roboczy silnik wykonawczy (Workhorse)
GEMINI_MODEL_WORKHORSE=gemini-3-flash

# Głęboka analiza biznesowo-techniczna, audyt barier B2B i architektura (Frontier)
GEMINI_MODEL_FRONTIER=gemini-3.1-pro